# ============================================================
# Fitness Hub - Variáveis de ambiente
# Copie para .env e ajuste os valores
# ============================================================

# App
APP_NAME=Fitness Hub
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000

# Frontend (CORS) - pode ser múltiplos separados por vírgula
CORS_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500

# Banco (Neon)
# Pegue a connection string no painel do Neon (com pooling)
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.sa-east-1.aws.neon.tech/fitnesshub?ssl=require

# JWT - OBRIGATÓRIO gerar uma chave forte em produção
# Pode usar: openssl rand -hex 32
JWT_SECRET=change-me-in-production-please-use-a-real-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Bcrypt
BCRYPT_ROUNDS=12
